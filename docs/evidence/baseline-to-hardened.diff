+# ═══════════════════════════════════════════════════════
+#  FINAL REPLY - deterministic output control
+# ═══════════════════════════════════════════════════════
+
+FALLBACK_REPLY = (
+    "I'm sorry, I wasn't able to complete that request. I can help with your NovaMart "
+    "orders, returns, refunds, shipping or warranty questions - could you tell me a "
+    "little more about what you need?")
+
+# Phrases that only appear when internal pipeline text leaks into a reply.
+_INTERNAL_MARKERS = re.compile(
+    r"agent findings|\bsession id\b|\bcustomer id\b|route_to_\w+|initialize_session|"
+    r"workflow ?state|workflow context|routing rules|specialist agent|prompt injection|"
+    r"\b(?:orchestrator|inventory|policy|refund|communication)agent\b",
+    re.IGNORECASE)
+_SENTENCE_END = re.compile(r"(?<=[.!?])\s+")
+
+
+def _remove_internal_sentences(text: str) -> tuple[str, int]:
+    """Drop every sentence that contains an internal marker. Returns (text, removed)."""
+    removed, kept_lines = 0, []
+    for line in text.splitlines():
+        sentences = _SENTENCE_END.split(line)
+        kept = [x for x in sentences if not _INTERNAL_MARKERS.search(x)]
+        removed += len(sentences) - len(kept)
+        if kept or not line.strip():
+            kept_lines.append(" ".join(kept))
+    return re.sub(r"\n{3,}", "\n\n", "\n".join(kept_lines)).strip(), removed
+
+
+def final_customer_reply(response, state: dict | None) -> tuple[str, str]:
+    """
+    Decide what the customer sees, in code rather than by prompt.
+
+    The orchestrator is instructed never to answer the customer itself, but an
+    instruction is not a control: in testing it answered a prompt-injection
+    attempt directly, mentioning its routing rules and the session ID. So:
+
+      1. CommunicationAgent output in WorkflowState is the only normal source
+         of a reply.
+      2. If the guardrail intervened, its configured message passes through
+         unchanged (the orchestrator's first model call was blocked, so no
+         worker ran).
+      3. Anything else - the orchestrator speaking for itself - is replaced
+         by a fixed, safe clarification message.
+
+    Every reply then passes a deterministic check for internal markers;
+    offending sentences are removed, and if nothing is left the fallback is
+    used. Returns (text, source) where source is one of 'communication_agent',
+    'guardrail', 'fallback'; anything other than 'communication_agent' is
+    logged as a warning so it can be counted in CloudWatch.
+    """
+    state = state or {}
+    raw = str(response).strip()
+    comm = _strip_xml_tags(state.get('communication_agent', '') or '').strip()
+
+    if comm:
+        text, source = comm, 'communication_agent'
+    elif (getattr(response, 'stop_reason', None) == 'guardrail_intervened'
+          or raw in (GUARDRAIL_BLOCKED_INPUT_MESSAGE, GUARDRAIL_BLOCKED_OUTPUT_MESSAGE)):
+        return raw, 'guardrail'
+    else:
+        logger.warning("Orchestrator produced a reply without the CommunicationAgent "
+                       "(session %s); returning the fallback message", state.get('session_id'))
+        return FALLBACK_REPLY, 'fallback'
+
+    cleaned, removed = _remove_internal_sentences(text)
+    if removed:
+        logger.warning("Removed %d sentence(s) containing internal markers from the reply "
+                       "(session %s)", removed, state.get('session_id'))
+    if not cleaned:
+        return FALLBACK_REPLY, 'fallback'
+    return cleaned, source
+
+
